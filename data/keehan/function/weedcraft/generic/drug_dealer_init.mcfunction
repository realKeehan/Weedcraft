## Configure a wandering trader to act as the Weedcraft drug dealer
    #> Called by /function keehan:weedcraft/commands/spawn_drug_dealer
    #>
    #> Sets the dealer's exact trade list directly on the entity (Offers.Recipes), so this
    #> dealer ALWAYS offers all of them and no other wandering trader is affected.
    #> Source of truth: data/keehan/villager_trade/* (wants->buy, gives->sell, max_uses->maxUses).
    #>   1: 3 diamonds        -> Weedcraft Field Guide
    #>   2: 1 Blunt           -> 2 diamonds   (dealer buys)
    #>   3: 1 Cocaine         -> 2 diamonds
    #>   4: 1 Crystal Meth    -> 3 diamonds
    #>   5: 1 Mixed Shrooms   -> 5 diamonds
    #>   6: 2 emeralds        -> Mystery Bag
    #>   7: 1 emerald         -> 4 Nether Wart
    #>   8: 3 emeralds        -> 4 Blaze Powder

    # Identify + persist + name the dealer (tag also drives the ETF skin)
    tag @s add weedcraft.drug_dealer
    data modify entity @s PersistenceRequired set value true
    data modify entity @s DespawnDelay set value 2147483647
    data modify entity @s CustomName set value {"text":"The Dealer","color":"dark_green","bold":true}
    data modify entity @s CustomNameVisible set value true

    # Replace the rolled trades with the exact dealer trade list
    data modify entity @s Offers.Recipes set value [
        {buy:{id:"minecraft:diamond",count:3},sell:{id:"minecraft:written_book",count:1,components:{"minecraft:written_book_content":{"title":{"raw":"Weedcraft Field Guide"},"author":"The Green Hand","resolved":true,"generation":0,"pages":[{"raw":{"text":"","extra":[{"text":"","font":"weedcraft:guide","color":"white"},{"text":"\n\n"},{"text":"Weedcraft Field Guide","bold":true,"color":"dark_green"},{"text":"\n\nPulled from a dealer's ledger. Handle with discretion.","color":"dark_gray","italic":true}]}},{"raw":{"text":"","extra":[{"text":"About","bold":true,"color":"dark_green"},{"text":"\nWeedcraft adds drug-themed farming, custom tools, and risky consumables.\n\n","color":"black"},{"text":"Harvest special crops with custom tools, craft four drugs, and trade with ","color":"black"},{"text":"The Dealer","color":"dark_green","bold":true},{"text":" — a wandering trader placed in the world.","color":"black"}]}},{"raw":{"text":"","extra":[{"text":"Tools & Harvest","bold":true,"color":"dark_green"},{"text":"\nChisel","bold":true,"color":"black"},{"text":": mine amethyst clusters → Bottled Amethyst.\n","color":"black"},{"text":"Loppers","bold":true,"color":"black"},{"text":": clip large ferns → Weed; mushrooms → Shredded Shrooms.\n","color":"black"},{"text":"Machete","bold":true,"color":"black"},{"text":": slice grown cocoa → Coca Leaves (beans still drop).","color":"black"}]}},{"raw":{"text":"","extra":[{"text":"Blunt Recipe","bold":true,"color":"green"},{"text":"\n\n\n\n\n\n\n"},{"text":"","font":"weedcraft:guide","color":"white"}]}},{"raw":{"text":"","extra":[{"text":"","font":"weedcraft:guide","color":"white"},{"text":"  "},{"text":"Blunt","bold":true,"color":"green"},{"text":"\nWeed + Paper + Magma Cream (shapeless).","color":"black"},{"text":"\n\nCome-up:\n","bold":true,"color":"dark_green"},{"text":"Levitation, blindness, and nausea hit first.","color":"dark_green"},{"text":"\n\nCrash:\n","bold":true,"color":"dark_red"},{"text":"Resistance, slowness, hunger, slow falling, mining fatigue.","color":"dark_red"}]}},{"raw":{"text":"","extra":[{"text":"Cocaine Recipe","bold":true,"color":"white"},{"text":"\n\n\n\n\n\n\n"},{"text":"","font":"weedcraft:guide","color":"white"}]}},{"raw":{"text":"","extra":[{"text":"","font":"weedcraft:guide","color":"white"},{"text":"  "},{"text":"Cocaine","bold":true,"color":"white"},{"text":"\nCoca Leaves + Sugar + Charcoal (shapeless).","color":"black"},{"text":"\n\nCome-up:\n","bold":true,"color":"dark_green"},{"text":"Brief blindness, then Speed III, Haste III, jump boost.","color":"dark_green"},{"text":"\n\nCrash:\n","bold":true,"color":"dark_red"},{"text":"Unluck and wither follow close behind.","color":"dark_red"}]}},{"raw":{"text":"","extra":[{"text":"Crystal Meth Recipe","bold":true,"color":"aqua"},{"text":"\n\n\n\n\n\n\n"},{"text":"","font":"weedcraft:guide","color":"white"}]}},{"raw":{"text":"","extra":[{"text":"","font":"weedcraft:guide","color":"white"},{"text":"  "},{"text":"Crystal Meth","bold":true,"color":"aqua"},{"text":"\nBottled Amethyst + Gunpowder + Bone Meal (shapeless).","color":"black"},{"text":"\n\nCome-up:\n","bold":true,"color":"dark_green"},{"text":"Strength and night vision surge in.","color":"dark_green"},{"text":"\n\nCrash:\n","bold":true,"color":"dark_red"},{"text":"Glowing marks you; nausea and poison grind you down.","color":"dark_red"},{"text":"\n\nAftermath: Absorption III lingers like a fading high.","color":"dark_gray","italic":true}]}},{"raw":{"text":"","extra":[{"text":"Mixed Shrooms Recipe","bold":true,"color":"light_purple"},{"text":"\n\n\n\n\n\n\n"},{"text":"","font":"weedcraft:guide","color":"white"}]}},{"raw":{"text":"","extra":[{"text":"","font":"weedcraft:guide","color":"white"},{"text":"  "},{"text":"Mixed Shrooms","bold":true,"color":"light_purple"},{"text":"\nRed + Brown Shredded Shrooms + Nether Wart (shapeless).","color":"black"},{"text":"\n\nCome-up:\n","bold":true,"color":"dark_green"},{"text":"Nausea first, then luck, night vision, regeneration, saturation.","color":"dark_green"},{"text":"\n\nCrash:\n","bold":true,"color":"dark_red"},{"text":"Weakness lingers after the rest fades.","color":"dark_red"}]}},{"raw":{"text":"","extra":[{"text":"Budding Amethyst Recipe","bold":true,"color":"light_purple"},{"text":"\n\n\n\n\n\n\n"},{"text":"","font":"weedcraft:guide","color":"white"}]}},{"raw":{"text":"","extra":[{"text":"Budding Amethyst","bold":true,"color":"light_purple"},{"text":"\nSurround a Nether Star with Amethyst Blocks for a real budding amethyst — renewable crystals.","color":"black"}]}},{"raw":{"text":"","extra":[{"text":"","font":"weedcraft:guide","color":"white"},{"text":"\n\n"},{"text":"The Dealer","bold":true,"color":"dark_green"},{"text":"\nHe doesn't ask where it came from.\n\n","color":"black"},{"text":"He buys:\n","bold":true,"color":"dark_aqua"},{"text":"Blunt 2◈  Cocaine 2◈  Meth 3◈  Shrooms 5◈\n\n","color":"black"},{"text":"He sells:\n","bold":true,"color":"dark_aqua"},{"text":"This Guide 3◈, Mystery Bag 2☘, Nether Wart 1☘, Blaze Powder 3☘","color":"black"}]}},{"raw":{"text":"","extra":[{"text":"Personal Account","bold":true,"color":"dark_purple"},{"text":"\nBlunt — manageable. Cocaine — I ran until I couldn't stop. Meth — I glowed in the dark for an hour. Shrooms — I lost track of time.\n\n","color":"black"},{"text":"Using all four at once is lethal. Don't. I did.\n\n- Author redacted","color":"dark_red","italic":true}]}}]},"minecraft:item_model":"weedcraft:field_guide"}},maxUses:10}
